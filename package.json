{
  "name": "comfortable-atcoder",
  "description": "Comfort your atcoder life. For more detail, visit https://github.com/drafear/comfortable-atcoder",
  "scripts": {
    "build": "npm run typecheck && npm run build:dist",
    "build:dist": "node scripts/build.cjs",
    "start": "npm run watch",
    "watch": "node scripts/build.cjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.cjs"
  },
  "devDependencies": {
    "@types/chrome": "0.0.75",
    "@types/jquery": "3.3.23",
    "archiver": "7.0.1",
    "chokidar": "4.0.3",
    "esbuild": "0.28.0",
    "less": "4.6.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "private": true,
  "default_locale": "en",
  "eslintIgnore": [
    "dist",
    "src/lib"
  ],
  "prettier": {
    "bracketSpacing": true,
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "release": {
    "verifyConditions": [
      "@semantic-release/github"
    ],
    "publish": [
      {
        "path": "@semantic-release/github",
        "assets": [
          {
            "path": "Release.zip"
          }
        ]
      }
    ],
    "success": [
      "@semantic-release/github"
    ],
    "fail": [
      "@semantic-release/github"
    ]
  }
}
